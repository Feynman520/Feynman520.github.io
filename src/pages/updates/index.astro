---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

const updates = (await getCollection('updates')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const books = await getCollection('books');
const bookTitle = (slug: string) => books.find((b) => b.data.slug === slug)?.data.title ?? slug;
const rendered = await Promise.all(updates.map(async (update) => ({ update, Content: (await render(update)).Content })));
const formatDate = (date: string) => new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' }).format(new Date(`${date}T00:00:00`));
---

<Base title="업데이트 — 함세준의 책" description="자료 갱신과 정오표를 날짜순으로 안내합니다.">
  <section class="page-hero">
    <div class="shell narrow">
      <p class="eyebrow">CHANGELOG</p>
      <h1>자료의 변화를<br />빠짐없이 기록합니다.</h1>
      <p class="lead">새로 공개한 자료, 수정한 내용, 정오표를 날짜순으로 확인하세요.</p>
    </div>
  </section>

  <section class="page-section updates-section">
    <div class="shell updates-layout">
      <aside>
        <span class="section-label">LATEST UPDATES</span>
        <strong>{updates.length}</strong>
        <p>공개된 업데이트</p>
        <a class="rss-link" href="/rss.xml">
          <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="4.8" cy="15.2" r="1.6" fill="currentColor" stroke="none" /><path d="M3.8 9.4a6.8 6.8 0 0 1 6.8 6.8M3.8 4.2A12 12 0 0 1 15.8 16.2" /></svg>
          RSS 구독
        </a>
      </aside>

      <div class="timeline">
        {rendered.map(({ update, Content }, index) => (
          <article class="update-entry">
            <div class="timeline-marker" aria-hidden="true"><span></span></div>
            <time datetime={update.data.date}>{formatDate(update.data.date)}</time>
            <div class="update-card">
              {(index === 0 || update.data.book) && (
                <div class="card-meta">
                  {index === 0 && <span class="latest-badge">LATEST</span>}
                  {update.data.book && (
                    <a class="book-chip" href={`/books/${update.data.book}/`}>{bookTitle(update.data.book)}</a>
                  )}
                </div>
              )}
              <h2>{update.data.title}</h2>
              <div class="prose"><Content /></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .updates-section { padding-top: 46px; }
  .updates-layout { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 88px; }
  .updates-layout > aside { position: sticky; top: 110px; align-self: start; padding-top: 9px; }
  .updates-layout > aside strong { display: block; margin-top: 20px; font-size: 48px; letter-spacing: -.06em; line-height: 1; }
  .updates-layout > aside p { margin: 7px 0 0; color: var(--muted); font-size: 13px; }
  .timeline { position: relative; }
  .timeline::before { position: absolute; top: 9px; bottom: 0; left: 8px; width: 1px; content: ''; background: var(--line-strong); }
  .update-entry { position: relative; display: grid; grid-template-columns: 18px 126px minmax(0, 1fr); gap: 22px; padding-bottom: 42px; }
  .timeline-marker { position: relative; z-index: 1; display: grid; width: 17px; height: 17px; margin-top: 5px; place-items: center; border: 1px solid #aebcf3; border-radius: 50%; background: var(--bg); }
  .timeline-marker span { width: 5px; height: 5px; border-radius: 50%; background: var(--brand); }
  .update-entry time { padding-top: 1px; color: var(--muted); font-size: 12.5px; font-weight: 700; white-space: nowrap; }
  .update-card { position: relative; padding: 27px 30px 29px; border: 1px solid var(--line); border-radius: 18px; background: rgba(255,255,255,.84); box-shadow: var(--shadow-sm); }
  .update-card h2 { margin-bottom: 14px; font-size: clamp(1.3rem, 2.5vw, 1.7rem); }
  .update-card .prose { font-size: 15px; line-height: 1.75; }
  .latest-badge { display: inline-block; color: var(--brand); font-size: 10px; font-weight: 850; letter-spacing: .12em; }
  .card-meta { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
  .book-chip { padding: 4px 11px; border-radius: 999px; color: var(--brand); background: var(--brand-soft); font-size: 11.5px; font-weight: 750; text-decoration: none; transition: background-color 150ms ease; }
  .book-chip:hover { background: #e2e9ff; }
  .rss-link { display: inline-flex; align-items: center; gap: 7px; margin-top: 18px; color: var(--brand); font-size: 13px; font-weight: 800; text-decoration: none; }
  .rss-link svg { width: 15px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.9; }

  @media (max-width: 820px) {
    .updates-layout { grid-template-columns: 1fr; gap: 35px; }
    .updates-layout > aside { position: static; display: flex; align-items: baseline; gap: 9px; padding: 0 0 20px; border-bottom: 1px solid var(--line-strong); }
    .updates-layout > aside .section-label { margin-right: auto; }
    .updates-layout > aside strong { margin: 0; font-size: 28px; }
    .updates-layout > aside p { margin: 0; }
    .updates-layout > aside .rss-link { margin-top: 0; }
  }

  @media (max-width: 600px) {
    .update-entry { grid-template-columns: 18px minmax(0, 1fr); gap: 15px; }
    .update-entry time { grid-column: 2; }
    .update-card { grid-column: 2; padding: 23px 21px; }
    .timeline-marker { grid-row: 1 / span 2; }
  }
</style>
