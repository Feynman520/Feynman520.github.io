---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
const updates = (await getCollection('updates')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const rendered = await Promise.all(
  updates.map(async (u) => ({ u, Content: (await render(u)).Content })),
);
---
<Base title="업데이트 — 함세준의 책">
  <h1>업데이트</h1>
  <p class="lead">자료 갱신과 정오표를 날짜순으로 공지합니다.</p>

  {rendered.map(({ u, Content }) => (
    <div class="card">
      <time style="color:var(--sub);font-size:13px">{u.data.date}</time>
      <h3 style="margin:2px 0 8px">{u.data.title}</h3>
      <div class="prose" style="font-size:15px;color:#444"><Content /></div>
    </div>
  ))}
</Base>
