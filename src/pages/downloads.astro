---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const books = (await getCollection('books')).sort((a, b) => a.data.order - b.data.order);
const totalFiles = books.reduce((total, book) => total + book.data.downloads.length, 0);
---

<Base title="자료실 — 함세준의 책" description="책의 모든 실습 자료와 가이드를 무료로 내려받을 수 있습니다.">
  <section class="page-hero">
    <div class="shell download-hero">
      <div class="narrow">
        <p class="eyebrow">DOWNLOAD CENTER</p>
        <h1>필요한 자료를<br />바로 시작하세요.</h1>
        <p class="lead">가입이나 로그인 없이 책의 모든 실습 자료를 내려받을 수 있습니다. 파일 주소는 앞으로도 그대로 유지됩니다.</p>
      </div>
      <aside class="download-summary" aria-label="자료실 요약">
        <span>현재 공개 자료</span>
        <strong>{totalFiles}<small>개 파일</small></strong>
        <p>마지막 갱신<br />{books[0]?.data.updated ?? '—'}</p>
      </aside>
    </div>
  </section>

  <section class="page-section download-content">
    <div class="shell">
      {books.map((book, index) => (
        <section class="book-downloads" aria-labelledby={`book-${book.data.slug}`}>
          <div class="book-download-head">
            <div>
              <span class="book-index">BOOK 0{index + 1}</span>
              <h2 id={`book-${book.data.slug}`}>{book.data.title}</h2>
              <p>{book.data.tagline}</p>
            </div>
            <a class="book-detail" href={`/books/${book.data.slug}/`}>
              책 소개 보기
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12m0 0-4.5-4.5M16 10l-4.5 4.5" /></svg>
            </a>
          </div>

          <div class="download-list">
            {book.data.downloads.map((item) => (
              <a class="download-item" href={item.file} download>
                <span class="file-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M7 3.5h7l4 4v13H7v-17Zm7 0v4h4M12 10v6m0 0 2.5-2.5M12 16l-2.5-2.5" /></svg>
                </span>
                <span class="download-copy">
                  <strong>{item.label}</strong>
                  {item.note && <span>{item.note}</span>}
                </span>
                {item.size && <span class="file-size">{item.size}</span>}
                <span class="download-action">
                  다운로드
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v9m0 0 3.5-3.5M10 12 6.5 8.5M4 15.5h12" /></svg>
                </span>
              </a>
            ))}
          </div>
        </section>
      ))}

      <aside class="safety-note">
        <span class="note-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 3 4.5 6v5.5c0 4.5 3 7.8 7.5 9.5 4.5-1.7 7.5-5 7.5-9.5V6L12 3Zm-3 9 2 2 4-4" /></svg>
        </span>
        <div>
          <strong>안심하고 연습하세요.</strong>
          <p>실습 데이터는 모두 가상의 한국고등학교 데이터입니다. 실존 인물이나 기관의 정보는 포함하지 않습니다.</p>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .download-hero { display: grid; grid-template-columns: minmax(0, 1fr) 260px; align-items: end; gap: 70px; }
  .download-summary { padding: 26px 28px; border: 1px solid var(--line); border-radius: 20px; background: rgba(255,255,255,.78); box-shadow: var(--shadow-sm); }
  .download-summary > span { color: var(--muted); font-size: 12px; font-weight: 750; letter-spacing: .06em; }
  .download-summary strong { display: block; margin: 8px 0 18px; color: var(--ink); font-size: 42px; letter-spacing: -.05em; line-height: 1; }
  .download-summary strong small { margin-left: 6px; color: var(--muted); font-size: 13px; font-weight: 650; letter-spacing: 0; }
  .download-summary p { margin: 0; padding-top: 16px; border-top: 1px solid var(--line); color: var(--muted); font-size: 12.5px; line-height: 1.6; }
  .download-content { padding-top: 48px; }
  .book-downloads + .book-downloads { margin-top: 92px; }
  .book-download-head { display: flex; align-items: end; justify-content: space-between; gap: 42px; margin-bottom: 28px; padding-bottom: 25px; border-bottom: 1px solid var(--line-strong); }
  .book-index { display: block; margin-bottom: 9px; color: var(--brand); font-size: 11px; font-weight: 800; letter-spacing: .12em; }
  .book-download-head h2 { margin-bottom: 8px; font-size: clamp(1.65rem, 3vw, 2.25rem); }
  .book-download-head p { max-width: 700px; margin: 0; color: var(--muted); font-size: 14.5px; }
  .book-detail { display: inline-flex; align-items: center; gap: 8px; color: var(--brand); font-size: 13.5px; font-weight: 800; text-decoration: none; white-space: nowrap; }
  .book-detail svg { width: 18px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.9; transition: transform 150ms ease; }
  .book-detail:hover svg { transform: translateX(3px); }
  .safety-note { display: flex; align-items: start; gap: 17px; margin-top: 50px; padding: 22px 24px; border: 1px solid #d5e9df; border-radius: 16px; background: rgba(234, 247, 240, .72); }
  .note-icon { display: grid; width: 40px; height: 40px; flex: none; place-items: center; border-radius: 11px; color: var(--success); background: #fff; }
  .note-icon svg { width: 21px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.7; }
  .safety-note strong { display: block; margin: 1px 0 3px; font-size: 14.5px; }
  .safety-note p { margin: 0; color: #426253; font-size: 13.5px; }

  @media (max-width: 760px) {
    .download-hero { grid-template-columns: 1fr; gap: 30px; }
    .download-summary { display: grid; grid-template-columns: 1fr auto; align-items: center; padding: 20px; }
    .download-summary strong { grid-row: span 2; margin: 0; }
    .download-summary p { padding: 6px 0 0; border-top: 0; }
    .book-download-head { align-items: start; flex-direction: column; gap: 14px; }
  }
</style>
