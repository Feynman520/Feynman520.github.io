---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const books = (await getCollection('books')).sort((a, b) => a.data.order - b.data.order);
const featured = books[0];
const downloadCount = books.reduce((total, book) => total + book.data.downloads.length, 0);
const totalRecipes = books.reduce((total, book) => total + book.data.recipes, 0);
---

<Base>
  <section class="home-hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">현직 교사가 쓴 AI 실전서</p>
        <h1>해결은 에이전트가,<br /><span>정의는 우리가.</span></h1>
        <p class="lead">
          수업 준비부터 학교 행정까지. 현장에서 직접 실행하고 검증한 AI 활용법을
          책과 실습 자료로 나눕니다.
        </p>
        <div class="button-row">
          <a class="button primary" href={featured ? `/books/${featured.data.slug}/` : '/downloads/'}>
            대표 도서 보기
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12m0 0-4.5-4.5M16 10l-4.5 4.5" /></svg>
          </a>
          <a class="button secondary" href="/downloads/">
            실습 자료 받기
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v9m0 0 3.5-3.5M10 12 6.5 8.5M4 15.5h12" /></svg>
          </a>
        </div>

        <div class="hero-facts" aria-label="사이트 핵심 정보">
          <div><strong>{totalRecipes}</strong><span>검증한 실전 레시피</span></div>
          <div><strong>{downloadCount}</strong><span>무료 실습 자료</span></div>
          <div><strong>100%</strong><span>재현 가능한 예제</span></div>
        </div>
      </div>

      {featured && (
        <a class="book-stage" href={`/books/${featured.data.slug}/`} aria-label={`${featured.data.title} 자세히 보기`}>
          <span class="orbit orbit-one" aria-hidden="true"></span>
          <span class="orbit orbit-two" aria-hidden="true"></span>
          <span class="book-shadow" aria-hidden="true"></span>
          <span class="book-object">
            <span class="book-spine" aria-hidden="true"></span>
            <span class="book-cover">
              <img src={featured.data.cover} alt={`${featured.data.title} 표지`} loading="eager" />
            </span>
          </span>
          <span class="stage-caption">
            <span class="status">{featured.data.status}</span>
            <span>책 소개 보기 <b aria-hidden="true">↗</b></span>
          </span>
        </a>
      )}
    </div>
  </section>

  <section class="page-section" id="books">
    <div class="shell">
      <div class="section-head">
        <div>
          <span class="section-label">BOOKS</span>
          <h2>현장에서 시작한 책</h2>
        </div>
        <p>말로만 그럴듯한 기능보다, 교사의 하루에서 실제로 시간을 돌려주는 방법을 다룹니다.</p>
      </div>

      <div class="book-list">
        {books.map((book, index) => (
          <article class="featured-book">
            <div class="book-number" aria-hidden="true">0{index + 1}</div>
            <div class="featured-book-copy">
              <span class:list={['status', book.data.status.includes('준비') && 'pending']}>{book.data.status}</span>
              <h3>{book.data.title}</h3>
              <p>{book.data.tagline}</p>
            </div>
            <div class="featured-book-actions">
              <a class="text-link" href={`/books/${book.data.slug}/`}>
                책 소개
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12m0 0-4.5-4.5M16 10l-4.5 4.5" /></svg>
              </a>
              {book.data.store.length === 0 && (
                <a class="text-link" href={`/books/${book.data.slug}/#book-notify`}>
                  출간 알림
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3.5c-2.7 0-4.4 2-4.4 4.4 0 3.6-1.6 4.6-1.6 4.6h12s-1.6-1-1.6-4.6c0-2.4-1.7-4.4-4.4-4.4Zm-1.6 12a1.7 1.7 0 0 0 3.2 0" /></svg>
                </a>
              )}
              <a class="button secondary small" href={`/downloads/#book-${book.data.slug}`}>자료 받기</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section principles-section">
    <div class="shell">
      <div class="section-head">
        <div>
          <span class="section-label">HOW IT WORKS</span>
          <h2>읽고 끝나지 않도록</h2>
        </div>
      </div>
      <div class="principle-grid">
        <article>
          <span class="principle-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4.5h11a3 3 0 0 1 3 3v12H8a3 3 0 0 1-3-3v-12Zm0 11.8A3.7 3.7 0 0 1 8 15h11M9 8h6" /></svg>
          </span>
          <span class="principle-no">01</span>
          <h3>실제로 검증했습니다</h3>
          <p>책에 실은 과정은 집필 중 직접 실행해 결과를 확인했습니다.</p>
        </article>
        <article>
          <span class="principle-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 19h14" /></svg>
          </span>
          <span class="principle-no">02</span>
          <h3>자료를 바로 받습니다</h3>
          <p>예제 데이터와 가이드를 주소 하나에서 언제든 내려받을 수 있습니다.</p>
        </article>
        <article>
          <span class="principle-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 8a7 7 0 1 0 1 7m0 0v-5m0 5h-5" /></svg>
          </span>
          <span class="principle-no">03</span>
          <h3>변경 사항을 이어 갑니다</h3>
          <p>도구가 바뀌어도 자료와 정오표를 계속 갱신해 같은 주소에 남깁니다.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="home-cta">
    <div class="shell cta-panel">
      <div class="cta-copy">
        <span class="section-label">START HERE</span>
        <h2>책을 펼쳤다면,<br />자료는 이미 준비되어 있습니다.</h2>
        <p>가입도, 로그인도 필요 없습니다. 필요한 파일을 골라 바로 시작하세요.</p>
        <a class="button primary" href="/downloads/">
          전체 자료 보기
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12m0 0-4.5-4.5M16 10l-4.5 4.5" /></svg>
        </a>
      </div>
      <a class="qr-card" href="https://feynman520.github.io/card/" target="_blank" rel="noreferrer" aria-label="함세준 디지털 명함 새 창에서 열기">
        <span class="qr-frame">
          <img src="/digital-card-qr.png" alt="함세준 디지털 명함 QR 코드" width="444" height="444" loading="lazy" />
        </span>
        <strong>QR 스캔 → 디지털 명함</strong>
        <small>feynman520.github.io/card</small>
      </a>
    </div>
  </section>
</Base>

<style>
  .home-hero { padding: 84px 0 98px; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(360px, .72fr); align-items: center; gap: 80px; }
  .hero-copy h1 { max-width: 760px; }
  .hero-copy h1 span { color: var(--brand); }
  .hero-copy .lead { max-width: 660px; }
  .hero-facts { display: flex; gap: 0; margin-top: 52px; }
  .hero-facts div { display: flex; flex-direction: column; min-width: 150px; padding-right: 28px; }
  .hero-facts div + div { padding-left: 28px; border-left: 1px solid var(--line-strong); }
  .hero-facts strong { color: var(--ink); font-size: 21px; letter-spacing: -0.035em; line-height: 1.25; }
  .hero-facts span { margin-top: 5px; color: var(--muted); font-size: 12.5px; white-space: nowrap; }

  .book-stage {
    position: relative;
    display: block;
    min-height: 520px;
    border: 1px solid rgba(210, 217, 235, .8);
    border-radius: 32px;
    color: inherit;
    background: linear-gradient(145deg, rgba(238, 242, 255, .92), rgba(255,255,255,.66));
    box-shadow: inset 0 1px 0 rgba(255,255,255,.9);
    text-decoration: none;
    overflow: hidden;
  }
  .book-stage::before { position: absolute; inset: 0; content: ''; background-image: radial-gradient(rgba(49,87,229,.16) .65px, transparent .65px); background-size: 14px 14px; mask-image: linear-gradient(to bottom, black, transparent 72%); }
  .orbit { position: absolute; border: 1px solid rgba(49, 87, 229, .12); border-radius: 50%; }
  .orbit-one { width: 370px; height: 370px; top: -100px; right: -100px; }
  .orbit-two { width: 250px; height: 250px; bottom: -90px; left: -80px; }
  .book-shadow { position: absolute; top: 348px; left: 50%; width: 245px; height: 42px; border-radius: 50%; background: rgba(26, 42, 95, .2); filter: blur(17px); transform: translateX(-44%) rotate(-5deg); }
  .book-object { position: absolute; top: 62px; left: 50%; display: flex; width: 250px; height: 330px; filter: drop-shadow(18px 22px 22px rgba(35, 48, 97, .22)); transform: translateX(-47%) rotate(4deg); transition: transform 280ms cubic-bezier(.2,.8,.2,1); }
  .book-stage:hover .book-object { transform: translateX(-47%) translateY(-8px) rotate(1.5deg); }
  .book-spine { width: 24px; border-radius: 8px 0 0 8px; background: linear-gradient(90deg, #b68d00, #f5be00); box-shadow: inset -4px 0 7px rgba(0,0,0,.18); }
  .book-cover { position: relative; display: block; flex: 1; border-radius: 0 9px 9px 0; overflow: hidden; }
  .book-cover img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .stage-caption { position: absolute; right: 28px; bottom: 25px; left: 28px; display: flex; align-items: center; justify-content: space-between; gap: 12px; color: var(--ink-soft); font-size: 13px; font-weight: 700; }
  .stage-caption .status { color: var(--brand); background: rgba(255,255,255,.74); backdrop-filter: blur(8px); }

  .book-list { border-top: 1px solid var(--line-strong); }
  .featured-book { display: grid; grid-template-columns: 76px minmax(0, 1fr) auto; align-items: center; gap: 28px; padding: 36px 0; border-bottom: 1px solid var(--line-strong); }
  .book-number { color: #b4bdca; font-size: 13px; font-weight: 800; letter-spacing: .1em; }
  .featured-book-copy h3 { margin: 12px 0 7px; font-size: clamp(1.45rem, 2.8vw, 2rem); }
  .featured-book-copy p { max-width: 680px; margin: 0; color: var(--muted); }
  .featured-book-actions { display: flex; align-items: center; gap: 20px; }
  .text-link { display: inline-flex; align-items: center; gap: 8px; color: var(--brand); font-size: 14px; font-weight: 800; text-decoration: none; white-space: nowrap; }
  .text-link svg { width: 18px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.9; transition: transform 150ms ease; }
  .text-link:hover svg { transform: translateX(3px); }

  .principles-section { position: relative; }
  .principle-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line-strong); border-bottom: 1px solid var(--line-strong); }
  .principle-grid article { position: relative; padding: 38px 36px 42px 0; }
  .principle-grid article + article { padding-left: 36px; border-left: 1px solid var(--line-strong); }
  .principle-icon { display: grid; width: 46px; height: 46px; margin-bottom: 34px; place-items: center; border-radius: 13px; color: var(--brand); background: var(--brand-soft); }
  .principle-icon svg { width: 23px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.7; }
  .principle-no { position: absolute; top: 49px; right: 26px; color: #a8b0bd; font-size: 11px; font-weight: 800; letter-spacing: .12em; }
  .principle-grid h3 { font-size: 18px; }
  .principle-grid p { margin-bottom: 0; color: var(--muted); font-size: 14.5px; }

  .home-cta { padding: 16px 0 112px; }
  .cta-panel { display: flex; align-items: center; justify-content: space-between; gap: 48px; padding: 54px 58px; border-radius: 28px; color: #fff; background: var(--ink); box-shadow: var(--shadow-lg); }
  .cta-panel .section-label { color: #9bb0ff; }
  .cta-panel h2 { margin-bottom: 14px; color: #fff; }
  .cta-panel p { max-width: 620px; margin-bottom: 0; color: #b9c0ce; }
  .cta-panel .button { flex: none; }
  .cta-copy .button { margin-top: 30px; }
  .qr-card { position: relative; display: flex; flex: none; align-items: center; flex-direction: column; padding: 22px 22px 18px; border: 1px solid rgba(255,255,255,.14); border-radius: 20px; color: #fff; background: rgba(255,255,255,.08); text-align: center; text-decoration: none; transition: transform 180ms ease, background-color 180ms ease; }
  .qr-card:hover { background: rgba(255,255,255,.12); transform: translateY(-3px); }
  .qr-frame { display: block; width: 186px; padding: 12px; border-radius: 13px; background: #fff; }
  .qr-frame img { display: block; width: 100%; height: auto; image-rendering: pixelated; }
  .qr-card strong { margin-top: 16px; font-size: 13px; letter-spacing: -.01em; }
  .qr-card small { margin-top: 4px; color: #98a2b3; font-size: 10.5px; letter-spacing: .035em; }

  @media (max-width: 1000px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr) 330px; gap: 46px; }
    .book-stage { min-height: 470px; }
    .book-object { top: 52px; transform: translateX(-50%) rotate(3deg) scale(.9); }
    .book-stage:hover .book-object { transform: translateX(-50%) translateY(-6px) rotate(1deg) scale(.9); }
    .book-shadow { top: 330px; }
  }

  @media (max-width: 820px) {
    .home-hero { padding: 62px 0 74px; }
    .hero-grid { grid-template-columns: 1fr; }
    .hero-copy { max-width: 690px; }
    .book-stage { min-height: 470px; }
    .featured-book { grid-template-columns: 48px minmax(0, 1fr); }
    .featured-book-actions { grid-column: 2; }
    .principle-grid { grid-template-columns: 1fr; }
    .principle-grid article { padding: 30px 0; }
    .principle-grid article + article { padding-left: 0; border-top: 1px solid var(--line-strong); border-left: 0; }
    .principle-no { top: 42px; right: 8px; }
    .cta-panel { align-items: start; flex-direction: column; padding: 44px; }
  }

  @media (max-width: 560px) {
    .home-hero { padding-top: 52px; }
    .hero-copy h1 { font-size: clamp(2.1rem, 10vw, 2.7rem); }
    .hero-facts { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 38px; }
    .hero-facts div { min-width: 0; padding-right: 12px; }
    .hero-facts div + div { padding-left: 12px; }
    .hero-facts strong { font-size: 18px; }
    .hero-facts span { font-size: 10.5px; white-space: normal; line-height: 1.45; }
    .book-stage { min-height: 420px; border-radius: 24px; }
    .book-object { top: 31px; transform: translateX(-50%) rotate(3deg) scale(.82); transform-origin: top center; }
    .book-stage:hover .book-object { transform: translateX(-50%) translateY(-4px) rotate(1deg) scale(.82); }
    .book-shadow { top: 287px; width: 220px; }
    .stage-caption { right: 20px; bottom: 20px; left: 20px; }
    .featured-book { grid-template-columns: 1fr; gap: 14px; }
    .book-number { display: none; }
    .featured-book-actions { grid-column: auto; align-items: stretch; flex-direction: column; gap: 12px; margin-top: 8px; }
    .featured-book-actions .button { width: 100%; }
    .text-link { justify-content: space-between; }
    .cta-panel { padding: 34px 26px; border-radius: 22px; }
    .cta-panel .button { width: 100%; }
  }
</style>
