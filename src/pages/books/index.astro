---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const books = (await getCollection('books')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="책 — 함세준의 책" description="현장에서 직접 실행해 검증한 AI 실전서 전체 목록입니다.">
  <section class="page-hero">
    <div class="shell narrow">
      <p class="eyebrow">BOOKS</p>
      <h1>현장에서 시작한<br />책들.</h1>
      <p class="lead">
        모든 책은 집필 중 직접 실행해 검증한 내용만 담습니다.
        실습 자료는 자료실에서 로그인 없이 받을 수 있습니다.
      </p>
    </div>
  </section>

  <section class="page-section books-index">
    <div class="shell">
      <div class="books-grid">
        {books.map((book) => (
          <article class="book-card">
            <a class="card-cover" href={`/books/${book.data.slug}/`} aria-label={`${book.data.title} 자세히 보기`}>
              <span class="card-book">
                <span class="card-spine" aria-hidden="true"></span>
                <img src={book.data.cover} alt={`${book.data.title} 표지`} loading="lazy" />
              </span>
            </a>
            <div class="card-body">
              <span class:list={['status', book.data.status.includes('준비') && 'pending']}>{book.data.status}</span>
              <h2><a href={`/books/${book.data.slug}/`}>{book.data.title}</a></h2>
              <p>{book.data.tagline}</p>
              <div class="card-actions">
                <a class="button secondary small" href={`/books/${book.data.slug}/`}>책 소개</a>
                {book.data.store.length > 0 ? (
                  <a class="card-link" href={`/books/${book.data.slug}/#book-stores`}>구매처 보기 <b aria-hidden="true">↗</b></a>
                ) : (
                  <a class="card-link" href={`/books/${book.data.slug}/#book-notify`}>출간 알림 받기 →</a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .books-index { padding-top: 40px; }
  .books-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: 24px; }
  .book-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.88);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: box-shadow 180ms ease, transform 180ms ease;
  }
  .book-card:hover { box-shadow: 0 16px 40px rgba(28, 45, 104, 0.12); transform: translateY(-3px); }
  .card-cover { display: grid; padding: 38px 38px 30px; place-items: center; background: linear-gradient(150deg, rgba(238, 242, 255, 0.92), rgba(255, 255, 255, 0.5)); }
  .card-book { display: flex; filter: drop-shadow(12px 16px 18px rgba(35, 48, 97, 0.2)); transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1); }
  .book-card:hover .card-book { transform: translateY(-4px); }
  .card-spine { width: 15px; border-radius: 6px 0 0 6px; background: linear-gradient(90deg, #b68d00, #f5be00); box-shadow: inset -3px 0 5px rgba(0, 0, 0, 0.16); }
  .card-book img { width: 166px; border-radius: 0 7px 7px 0; }
  .card-body { display: flex; flex: 1; flex-direction: column; padding: 24px 26px 26px; }
  .card-body h2 { margin: 13px 0 7px; font-size: 1.35rem; }
  .card-body h2 a { color: var(--ink); text-decoration: none; }
  .card-body h2 a:hover { color: var(--brand); }
  .card-body > p { flex: 1; margin: 0; color: var(--muted); font-size: 14px; line-height: 1.65; word-break: keep-all; }
  .card-actions { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-top: 20px; }
  .card-link { color: var(--brand); font-size: 13.5px; font-weight: 800; text-decoration: none; white-space: nowrap; }
  .card-link:hover { text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 560px) {
    .books-grid { grid-template-columns: 1fr; }
    .card-cover { padding: 30px 30px 24px; }
    .card-body { padding: 21px 22px 23px; }
  }
</style>
