---
import Base from '../layouts/Base.astro';
---

<Base title="페이지를 찾을 수 없습니다 — 함세준의 책">
  <section class="not-found">
    <div class="shell not-found-inner">
      <span class="error-code">404</span>
      <p class="eyebrow">PAGE NOT FOUND</p>
      <h1>페이지를 찾을 수 없습니다.</h1>
      <p class="lead">주소가 잘못 입력되었거나 페이지가 이동했습니다. 홈 또는 자료실에서 다시 시작해 주세요.</p>
      <div class="button-row">
        <a class="button primary" href="/">홈으로 돌아가기</a>
        <a class="button secondary" href="/downloads/">자료실 열기</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .not-found { display: grid; min-height: 70vh; padding: 90px 0; place-items: center; }
  .not-found-inner { max-width: 720px; text-align: center; }
  .error-code { display: block; margin-bottom: -18px; color: #dfe5fb; font-size: clamp(7rem, 22vw, 13rem); font-weight: 900; letter-spacing: -.09em; line-height: .8; }
  .not-found .eyebrow { position: relative; }
  .not-found h1 { font-size: clamp(2.1rem, 5vw, 3.7rem); }
  .not-found .lead { margin-inline: auto; }
  .not-found .button-row { justify-content: center; }
</style>
